{
	"name": "n8n-nodes-dmly",
	"version": "0.1.2",
	"description": "This is an n8n community node. It lets you use DMLY in your n8n workflows.",
	"keywords": [
		"dmly",
		"whatsapp",
		"messaging",
		"crm",
		"n8n-community-node-package"
	],
	"license": "MIT",
	"homepage": "https://dmly.io",
	"author": {
		"name": "DMLY"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DMLY-IO/n8n-nodes-dmly.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/DmlyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Dmly/Dmly.node.js",
			"dist/nodes/DmlyTrigger/DmlyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^18.16.16",
		"@typescript-eslint/parser": "^5.59.7",
		"eslint": "^8.41.0",
		"eslint-plugin-n8n-nodes-base": "^1.14.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^1.0.0",
		"prettier": "^2.8.8",
		"typescript": "^5.0.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
